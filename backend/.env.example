# ── Server ────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ───────────────────────────────────────────
# Local:          mongodb://localhost:27017/event-ats
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/event-ats
MONGO_URI=mongodb://localhost:27017/event-ats

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Email ──────────────────────────────────────────────
# Option A — Ethereal (dev/demo): leave blank, auto-creates a test account each restart
# Option B — Resend (free 3k/month): https://resend.com → API Keys
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_USER=resend
#   EMAIL_PASS=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
#   EMAIL_FROM=TalentFlow <onboarding@resend.dev>
# Option C — SendGrid (free 100/day): https://app.sendgrid.com → API Keys
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_USER=apikey
#   EMAIL_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# Option D — Gmail SMTP (personal demo):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=you@gmail.com
#   EMAIL_PASS=your-app-password   (requires 2FA + App Password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=TalentFlow ATS <noreply@talentflow.dev>

# ── SMS ────────────────────────────────────────────────
# Leave blank to use the mock (console log + AuditLog entry).
# Twilio free trial: https://www.twilio.com/try-twilio
#   — gives $15 credit, ~100+ SMS to verified numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── CORS ───────────────────────────────────────────────
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app (or Render static site URL)
FRONTEND_URL=http://localhost:5173
